# Copy this file to .env (or set the variables as "Public" in the hosting dashboard).
# Every VITE_ value is public and fixed at build time, so rebuild after changing one.
# Never put a secret in a VITE_ variable.

# Shown in the page footer.
VITE_APP_LABEL=local

# Supabase project URL and publishable key. Both are safe in the browser.
# The Supabase secret key must never appear here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
